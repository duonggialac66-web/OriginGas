// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
  output     = "../api/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  name      String
  username  String    @unique
  password  String? // Nếu có chức năng login thực tế
  role      String    @default("employee") // "admin" | "employee"
  phone     String?
  startDate DateTime?
  status    String    @default("active") // "active" | "inactive"
  avatarUrl String? // Dùng cho Cloudinary (ảnh đại diện)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  reports DeliveryReport[]
}

model DeliveryReport {
  id             String   @id @default(uuid())
  employeeId     String
  employee       User     @relation(fields: [employeeId], references: [id])
  date           String // Lưu ngày dạng "YYYY-MM-DD"
  customerName   String
  quantity       Int // Số lượng bình đầy giao cho khách
  containerType  String
  unitPrice      Float
  total          Float
  actualReceived Float
  notes          String?
  receiptUrl     String? // Dùng cho Cloudinary (ảnh hóa đơn/biên nhận)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Inventory {
  id            String   @id @default(uuid())
  containerType String   @unique
  fullQuantity  Int      @default(0) // Bình đầy (có gas)
  updatedAt     DateTime @updatedAt
}
