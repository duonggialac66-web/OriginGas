// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(uuid())
  name       String
  username   String    @unique
  password   String? // Nếu có chức năng login thực tế
  role       String    @default("employee") // "admin" | "employee"
  phone      String?
  startDate  DateTime?
  status     String    @default("active") // "active" | "inactive"
  baseSalary Float     @default(0) // Lương cơ bản
  avatarUrl  String? // Dùng cho Cloudinary (ảnh đại diện)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  reports  DeliveryReport[]
  expenses Expense[]
}

model DeliveryReport {
  id             String   @id @default(uuid())
  employeeId     String
  employee       User     @relation(fields: [employeeId], references: [id])
  date           String // Lưu ngày dạng "YYYY-MM-DD"
  customerName   String
  quantity       Int // Số lượng bình đầy giao cho khách
  containerType  String
  unitPrice      Float
  total          Float
  actualReceived Float
  notes          String?
  receiptUrl     String? // Dùng cho Cloudinary (ảnh hóa đơn/biên nhận)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Inventory {
  id            String   @id @default(uuid())
  containerType String   @unique
  fullQuantity  Int      @default(0) // Bình đầy (có gas)
  updatedAt     DateTime @updatedAt
}

model SalaryConfig {
  id            String   @id @default(uuid())
  containerType String   @unique
  commission    Float    @default(0) // Số tiền nhận được cho mỗi bình giao thành công
  updatedAt     DateTime @updatedAt
}

model SalaryFormula {
  id        String   @id @default(uuid())
  formula   String   @default("baseSalary * overtime")
  updatedAt DateTime @updatedAt
}

model MonthlySalaryInput {
  id               String   @id @default(uuid())
  employeeId       String
  month            String // YYYY-MM
  overtime         Float    @default(1.0)
  workDays         Float    @default(26.0)
  bonus            Float    @default(0.0)
  calculatedSalary Float    @default(0.0)
  updatedAt        DateTime @updatedAt

  @@unique([employeeId, month])
}

model Expense {
  id          String   @id @default(uuid())
  employeeId  String
  employee    User     @relation(fields: [employeeId], references: [id])
  date        String // YYYY-MM-DD
  description String // Mô tả khoản chi
  amount      Float // Số tiền chi
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
